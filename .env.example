# Add local environment variables here when needed. Do not put real keys in this file.
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
STT_TIMEOUT_MS=90000
STT_GEMINI_MODEL=
DOCTOR_NAME=
DOCTOR_PASSWORD=
# Legacy shared passcode; used only when DOCTOR_NAME and DOCTOR_PASSWORD are unset.
DOCTOR_PASSCODE=
NURSE_NAME=
NURSE_PASSWORD=
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: point at an isolated SQLite file for local testing.
HACKATHON_DB_PATH=
# Demo only: set to 1 to shorten summary regeneration cooldown to about 1 second.
DEMO_COOLDOWN_OFF=
# Resend transactional email provider for nurse survey decisions; leave blank to disable sending.
RESEND_FROM_EMAIL=
CRON_SECRET=
